# Copia este archivo como .env y añade tu clave localmente.
# Usa un proyecto Free Tier SIN facturación habilitada si quieres coste cero.
# No pegues la clave en el chat ni la subas a Git.
GEMINI_API_KEY=""
GEMINI_ENABLED=true

# Clave independiente de Google Maps para el autocompletado del checkout.
# Limítala a Maps JavaScript/Places y a los dominios de tu aplicación.
GOOGLE_MAPS_API_KEY=""
